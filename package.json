{
  "name": "@happyvertical/pdf",
  "version": "0.65.2",
  "description": "Node.js PDF extraction, OCR fallback, image extraction, and PDF generation utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "pdfjs-dist": "5.4.296"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": [
    "pdf",
    "ocr",
    "text-extraction",
    "pdf-generation",
    "html-to-pdf",
    "markdown-to-pdf",
    "unpdf"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/pdf.git"
  },
  "bugs": {
    "url": "https://github.com/happyvertical/pdf/issues"
  },
  "homepage": "https://github.com/happyvertical/pdf#readme",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run --testTimeout 120000",
    "test:coverage": "vitest run --coverage --testTimeout 120000",
    "test:watch": "vitest --testTimeout 120000",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write src/",
    "docs:api": "typedoc --options typedoc.json",
    "docs:api:check": "tsx scripts/check-generated-api-docs.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "npm run build:watch & npm run test:watch",
    "changeset": "changeset",
    "changeset:auto": "npx tsx scripts/auto-changeset.ts",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@happyvertical/ocr": "^0.60.53",
    "@happyvertical/utils": "^0.74.9",
    "@napi-rs/canvas": "0.1.99",
    "marked": "^14.1.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "puppeteer-core": "^25.1.0",
    "unpdf": "^1.4.0"
  },
  "optionalDependencies": {
    "@kreuzberg/node": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "^4.0.15",
    "lefthook": "^1.11.13",
    "tsx": "^4.20.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "vite": "7.3.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "^4.0.8"
  }
}
